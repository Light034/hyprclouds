(deflisten openedapps :initial "[]" "/home/gonzalo/Documents/github/wf-getapps/build/wf-getapps --follow --compact")
(defwidget open_apps []
  (box  :orientation "h"
        :space-evenly false 
        :spacing 5 
        :class "activeapps"
      (for app in {openedapps}
          (button :class "app_item ${app.active == true ? "active" : ""}" 
                  :onclick "wlrctl toplevel focus title:\"${app.title}\""
              (image :path {app.icon_path} :image-width 30 :image-height 30)
          )
      )
  )
)
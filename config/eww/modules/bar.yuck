;; Description: Main bar widget that contains clock, workspaces, tray button, language, expand, indicator, and power widgets.

;; Bar widget and the configuration of the widgets.
(defwidget bar []
    (box :class "bar-widget" :orientation "h" :space-evenly true

        (box :orientation "h" :space-evenly false :halign "start"
            (logo)
             (clock)
             (weathery)
          
        )

        (box :orientation "h" :space-evenly false :halign "center"
          
        (open_apps)
        )

        (box :orientation "h" :space-evenly false :halign "end"
       
            (tray_button)
            (language)
            (expand)
            (indicator)
            (power)
        )

    )
    
)

;; Corner decorations for main screen. Not sure what they are doing here but whatever lol
(defwindow topside-edge [ monitor ]
 :exclusive true
 :active false
 :focusable false
  :monitor "${monitor}"
  :geometry (geometry 
              :x "0px"
                :y "-1.1%"
              :anchor "center top")
  (box :class "topside edge")  
)


(defwindow leftside-edge [ monitor ]
 :exclusive true
  :monitor "${monitor}"
  :geometry (geometry 
              :x "-0.6%"
                :y "0px"
              :anchor "center left")
  (box :class "leftside edge")  
)

(defwindow rightside-edge [ monitor ]
 :exclusive true
  :monitor "${monitor}"
  :geometry (geometry 
              :x "-0.6%"
                :y "0px"
              :anchor "center right")
  (box :class "rightside edge")  
)


(defwindow corner-left [ monitor ]
  :stacking "fg"
  :monitor "${monitor}"
  :geometry (geometry 
              :x "19.1%"
              :y "0px"
              :anchor "bottom left")
  (box :class "corner left")  
)

(defwindow corner-right [ monitor ]

  :stacking "fg"
  :focusable false
  :exclusive false
  :monitor "${monitor}"
  :geometry (geometry 
              :x "18.9%"
              :y "-0px"
              :anchor "bottom right")
              (revealer :transition "slideup" :reveal {open_cc} :duration {ANIM_DURATION}
  (box :class "corner right")  
              )
)
(defwindow topbgcorner-left [ monitor ]
  :stacking "fg"
  :monitor "${monitor}"
  :geometry (geometry 
              :y "-1.1%"
              :x "-0.59%"
              :anchor "top left")
  (box :class "topbgcorner left")  
)

(defwindow topbgcorner-right [ monitor ]

  :stacking "fg"
  :monitor "${monitor}"
  :geometry (geometry 
              :x "-0.59%"
              :y "-1.1%"
              :anchor "top right")
  (box :class "topbgcorner right")  
)

(defwindow bgcorner-left [ monitor ]
  :stacking "fg"
  :monitor "${monitor}"
  :geometry (geometry 
              :x "-0.6%"
              :y "0%"
              :anchor "bottom left")
  (box :class "bgcorner left")  
)

(defwindow bgcorner-right [ monitor ]

  :stacking "fg"
  :monitor "${monitor}"
  :geometry (geometry 
              :x "-0.6%"
              :y "0px"
              :anchor "bottom right")
  (box :class "bgcorner right")  
)
(defwindow topcorner-left [ monitor ]
  :stacking "fg"
  :monitor "${monitor}"
  :focusable false
  :exclusive false
  :geometry (geometry 
              :x "-0.6%"
              :y "31.5%"
              :anchor "bottom left")
  (box :class "bgcorner left")  
)

(defwindow topcorner-right [ monitor ]

  :stacking "fg"
  :monitor "${monitor}"
  :geometry (geometry 
              :x "-0.6%"
              :y "60.2%"
              :anchor "bottom right")
              (revealer :transition "slideleft" :reveal {open_cc} :duration {ANIM_DURATION}
  (box :class "bgcorner right")  
)
)
(defwindow volcorner-left [ monitor ]
  :stacking "fg"
  :monitor "${monitor}"
  :geometry (geometry 
               :x "792"
              :y "0"
              :anchor "bottom left")
  (box :class "bgcorner left")  
)

